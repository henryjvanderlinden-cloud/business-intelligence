  "checks": "SELECT OBJECT_SCHEMA_NAME(k.parent_object_id) AS schema_name, OBJECT_NAME(k.parent_object_id) AS table_name, k.name AS check_name, COL_NAME(k.parent_object_id,k.parent_column_id) AS column_name, CAST(k.definition AS nvarchar(2000)) AS definition, k.is_disabled, k.is_not_trusted FROM sys.check_constraints k ORDER BY schema_name, table_name, check_name",
  "columns": "SELECT t.object_id, SCHEMA_NAME(t.schema_id) AS schema_name, t.name AS table_name, c.column_id, c.name AS column_name, ty.name AS type_name, c.max_length, c.precision, c.scale, c.is_nullable, c.is_identity, c.is_computed, c.is_masked, c.generated_always_type_desc, CAST(dc.definition AS nvarchar(400)) AS default_definition, CAST(cc.definition AS nvarchar(2000)) AS computed_definition, CAST(ep.value AS nvarchar(4000)) AS description FROM sys.tables t JOIN sys.columns c ON c.object_id=t.object_id JOIN sys.types ty ON ty.user_type_id=c.user_type_id LEFT JOIN sys.default_constraints dc ON dc.parent_object_id=c.object_id AND dc.parent_column_id=c.column_id LEFT JOIN sys.computed_columns cc ON cc.object_id=c.object_id AND cc.column_id=c.column_id LEFT JOIN sys.extended_properties ep ON ep.class=1 AND ep.major_id=c.object_id AND ep.minor_id=c.column_id AND ep.name='Description' WHERE SCHEMA_NAME(t.schema_id) IN ('Application','Purchasing','Sales','Warehouse') ORDER BY schema_name, table_name, c.column_id",
  "fks": "SELECT fk.name AS fk_name, OBJECT_SCHEMA_NAME(fkc.parent_object_id) AS schema_name, OBJECT_NAME(fkc.parent_object_id) AS table_name, COL_NAME(fkc.parent_object_id,fkc.parent_column_id) AS column_name, OBJECT_SCHEMA_NAME(fkc.referenced_object_id) AS ref_schema, OBJECT_NAME(fkc.referenced_object_id) AS ref_table, COL_NAME(fkc.referenced_object_id,fkc.referenced_column_id) AS ref_column, fkc.constraint_column_id, fk.is_disabled, fk.is_not_trusted, fk.delete_referential_action_desc FROM sys.foreign_keys fk JOIN sys.foreign_key_columns fkc ON fkc.constraint_object_id=fk.object_id ORDER BY schema_name, table_name, fk_name, fkc.constraint_column_id",
  "keys": "SELECT SCHEMA_NAME(t.schema_id) AS schema_name, t.name AS table_name, i.name AS index_name, i.type_desc, i.is_primary_key, i.is_unique, i.is_unique_constraint, CAST(i.filter_definition AS nvarchar(400)) AS filter_definition, COL_NAME(ic.object_id,ic.column_id) AS column_name, ic.key_ordinal, ic.is_included_column FROM sys.tables t JOIN sys.indexes i ON i.object_id=t.object_id JOIN sys.index_columns ic ON ic.object_id=i.object_id AND ic.index_id=i.index_id WHERE SCHEMA_NAME(t.schema_id) IN ('Application','Purchasing','Sales','Warehouse') AND i.type>0 ORDER BY schema_name, table_name, i.name, ic.key_ordinal",
  "masked": "SELECT OBJECT_SCHEMA_NAME(m.object_id) AS schema_name, OBJECT_NAME(m.object_id) AS table_name, m.name AS column_name, CAST(m.masking_function AS nvarchar(400)) AS masking_function FROM sys.masked_columns m",
